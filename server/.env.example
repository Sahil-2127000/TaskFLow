# Current working environment (development / production)
NODE_ENV=development

# Client side URL for CORS
CLIENT_URL=http://localhost:5173

# Server Port
PORT=4000

# MongoDB connection string
MONGODB_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/taskFlow

# Gmail REST API OAuth2 Configuration (Render & Production Safe)
GMAIL_USER=your_email@gmail.com
GMAIL_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=GOCSPX-your_oauth_client_secret
GMAIL_REFRESH_TOKEN=1//your_oauth_refresh_token

# JWT Secret Key
JWT_SECRET=your_jwt_secret_key
